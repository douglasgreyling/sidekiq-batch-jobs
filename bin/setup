#!/usr/bin/env bash
# Build both images and resolve every Appraisal lane. Run once after cloning,
# and again whenever the Dockerfile, the Gemfile or Appraisals changes.

set -euo pipefail

cd "$(dirname "$0")/.."

docker compose build gem gem-ruby34

# Regenerate gemfiles/ from Appraisals, then resolve each lane on a Ruby that
# can actually run it.
docker compose run --rm -e BUNDLE_GEMFILE=/gem/Gemfile gem bundle install
docker compose run --rm -e BUNDLE_GEMFILE=/gem/Gemfile gem bundle exec appraisal generate

echo
echo "════════ resolving rails_7.2 (Ruby 3.1.7) ════════"
docker compose run --rm -e BUNDLE_GEMFILE="/gem/gemfiles/rails_7.2.gemfile" gem bundle install

for lane in rails_8.0 rails_8.1; do
  echo
  echo "════════ resolving ${lane} (Ruby 3.4.6) ════════"
  docker compose run --rm -e BUNDLE_GEMFILE="/gem/gemfiles/${lane}.gemfile" gem-ruby34 bundle install
done

echo
echo "Done. Run the suite with: bin/test  (or bin/test --all)"
