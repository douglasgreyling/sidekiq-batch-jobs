#!/usr/bin/env bash
# Wrapper that ensures Postgres is up before running rspec.
#
# Usage:
#   bin/test                  # run the full suite
#   bin/test spec/models      # pass args through to rspec

set -euo pipefail

cd "$(dirname "$0")/.."

if ! docker compose ps --status running --services 2>/dev/null | grep -q '^postgres$'; then
  echo "→ Starting Postgres via docker compose…"
  docker compose up -d postgres
fi

echo "→ Waiting for Postgres to accept connections…"
until docker compose exec -T postgres pg_isready -U postgres >/dev/null 2>&1; do
  sleep 0.5
done

exec bundle exec rspec "$@"
