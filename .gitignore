/.bundle/
/.yardoc
/_yardoc/
/coverage/
/doc/
/pkg/
/spec/reports/
# Everything the suite writes here, including rotated logs: `*.log` alone
# misses test.log.0, which reaches 100MB and is rejected by GitHub.
/spec/internal/log/*
!/spec/internal/log/.gitkeep
/spec/internal/tmp/
/tmp/

# rspec failure tracking
.rspec_status
